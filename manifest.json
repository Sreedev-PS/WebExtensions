{
  "manifest_version": 3,
  "name": "LinkedIn Job Finder Helper",
  "version": "1.0.4",
  "description": "Collect LinkedIn job search results and preserve saved jobs.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_title": "LinkedIn Job Finder",
    "default_popup": "popup.html"
  }
}